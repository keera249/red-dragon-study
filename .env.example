# Database Connection
# For local development (SQLite zero-config) or PostgreSQL in production:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/red_dragon_study?schema=public"

# Authentication & Security
JWT_SECRET="red-dragon-study-super-secret-jwt-key-change-in-production-2026"
SESSION_DURATION_HOURS="24"

# Initial Admin Seed Credentials (used only during initial db:seed)
INITIAL_ADMIN_EMAIL="admin@reddragonstudy.com"
INITIAL_ADMIN_PASSWORD="Admin@RedDragon2026!"

# Application Settings
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
DEFAULT_TIMEZONE="Asia/Shanghai"
